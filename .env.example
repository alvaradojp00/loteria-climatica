# Lotería Climática — required environment variables
#
# Copy this file to `.env` in this folder (or keep one `.env` in the parent
# course folder — the app looks here first, then one level up) and fill in the
# values. NEVER commit the real `.env`.

# --- Required -------------------------------------------------------------
# Yale course gateway key. The agent runs on gpt-6-luna through Portkey.
PORTKEY_API_KEY=

# --- Optional -------------------------------------------------------------
# Every key below is OPTIONAL and UNUSED by default: the app runs fully on
# PORTKEY_API_KEY alone. The brief falls back to its committed fixture, and
# the sending channels stay dormant.
# Only if running a non-course model on your own account and your own money.
OPENAI_API_KEY=

# El Boletín ingest. Leave blank to run on the open/fixture adapters, which
# need no credentials — the biweekly brief still works without this.
JUNKIPEDIA_API_KEY=

# Password for El Taller, the operator surface (gap queue, minting,
# approvals). Change it. Defaults to 'loteria-admin' when unset.
ADMIN_PASSWORD=

# Sending. Both channels are built but dormant: with these unset the
# admin exports a CSV and sends manually. See backend/senders.py.
EMAIL_API_KEY=
EMAIL_FROM=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
